# 이 파일은 커밋합니다. 값은 비워 두고, 키 이름만 공유하기 위한 것입니다.
# 실제 값은 .env 에 적고, .env 는 커밋하지 않습니다.
#
#   cp .env.example .env
#   git check-ignore -v .env     # 규칙 줄이 찍히면 정상

# TimescaleDB
POSTGRES_DB=iot
POSTGRES_USER=iot
POSTGRES_PASSWORD=

# 호스트에 노출할 포트 (충돌 시 이 값만 바꾸세요)
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
ADMINER_PORT=8080

# 세션 유효시간(분)
SESSION_TTL_MINUTES=120

# 한국투자증권 OpenAPI — 실전과 모의를 두 벌로 나눕니다
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=
